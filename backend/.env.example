# Backend Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ================================
# Database Configuration
# ================================
DATABASE_URL=sqlite:///./asylum_bot_web.db
DATABASE_ECHO=false

# ================================
# FastAPI Configuration
# ================================
# Environment: development, staging, production
ENVIRONMENT=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# ================================
# Security Configuration
# ================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your_secret_key_here_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ================================
# CORS Configuration
# ================================
# Frontend URLs that can access the API
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=*

# ================================
# Default User Credentials
# ================================
# These will be created on first startup
DEFAULT_DEVELOPER_EMAIL=developer@asylum-bot.local
DEFAULT_DEVELOPER_PASSWORD=dev_password_change_me
DEFAULT_USER_EMAIL=user@asylum-bot.local
DEFAULT_USER_PASSWORD=user_password_change_me

# ================================
# Bot Integration Configuration
# ================================
# Path to the existing bot project
BOT_PROJECT_PATH=../src
BOT_LOG_PATH=../logs
BOT_DATABASE_PATH=../asylum_bot.db

# ================================
# WebSocket Configuration
# ================================
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=100

# ================================
# Logging Configuration
# ================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=backend/logs/web_api.log

# ================================
# Rate Limiting
# ================================
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ================================
# File Upload Configuration
# ================================
MAX_UPLOAD_SIZE_MB=10
UPLOAD_PATH=backend/uploads

# ================================
# External Services (Optional)
# ================================
# If you want to integrate with external monitoring
SENTRY_DSN=
PROMETHEUS_METRICS_PORT=9090

# ================================
# Production Deployment (Render)
# ================================
# These are set automatically by Render
# PORT=8000
# DATABASE_URL=postgresql://...
# REDIS_URL=redis://...

# ================================
# Development Only
# ================================
# Auto-reload on code changes
RELOAD=true
# Show detailed error pages
SHOW_ERRORS=true
