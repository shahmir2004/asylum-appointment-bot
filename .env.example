# Asylum Appointment Booking Bot - Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# EMAIL NOTIFICATION SETTINGS (Required for notifications)
# =============================================================================
# Get Gmail App Password: https://support.google.com/accounts/answer/185833
GMAIL_USERNAME=your-gmail@gmail.com
GMAIL_PASSWORD=your-gmail-app-password-here
RECIPIENT_EMAIL=your-gmail@gmail.com

# =============================================================================
# USER INFORMATION (Used for booking forms)
# =============================================================================
DEFAULT_USER_NAME=Your Full Name
DEFAULT_USER_EMAIL=your-email@gmail.com

# =============================================================================
# BOT CONFIGURATION
# =============================================================================
# Site URL (don't change unless testing different sites)
SITE_URL=https://icp.administracionelectronica.gob.es

# Monitoring interval in seconds (120 = 2 minutes)
MONITORING_INTERVAL=120

# Safety settings (KEEP THESE TRUE FOR SAFETY!)
DRY_RUN_MODE=true
TEST_MODE=true
AUTO_BOOKING_ENABLED=false

# Browser settings
HEADLESS_BROWSER=true
BROWSER_TIMEOUT_MS=45000

# =============================================================================
# STEALTH CONFIGURATION (Advanced features)
# =============================================================================
STEALTH_ENABLED=true

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=sqlite:///asylum_bot.db

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/asylum_bot.log

# =============================================================================
# RETRY CONFIGURATION
# =============================================================================
MAX_RETRIES=3
RETRY_DELAY=5
BOOKING_TIMEOUT=30

# =============================================================================
# DEVELOPMENT SETTINGS (Optional)
# =============================================================================
# Uncomment these for development/debugging
# DEBUG_MODE=true
# VERBOSE_LOGGING=true
